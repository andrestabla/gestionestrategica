# ── Base de datos ─────────────────────────────────────────────────────────────
# Local (SQLite, sin servicios): file:./var/4shine.db  → npm run db:migrate && npm run db:seed
# Producción (PostgreSQL: Neon, Vercel Postgres o propio) → el build ejecuta
# prisma migrate deploy con prisma/postgres; luego npm run db:pg:seed una vez.
DATABASE_URL="file:./var/4shine.db"

# ── Sesión ────────────────────────────────────────────────────────────────────
# Firma HMAC de la cookie y de los enlaces públicos. Generar: openssl rand -base64 32
AUTH_SECRET=""

# ── Acceso ────────────────────────────────────────────────────────────────────
# "off" desactiva la contraseña demo: solo entra quien tiene contraseña fijada
# en la base (POST /api/td/users/password, rol con manage_users).
DEMO_LOGIN="on"

# ── Archivos (evidencias y recursos de marca) ─────────────────────────────────
# Sin estas cuatro variables se escribe en var/uploads y var/branding (local).
# Con ellas, en Cloudflare R2 (API S3). En Vercel el disco es efímero: usar R2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ── Inteligencia (opcional) ───────────────────────────────────────────────────
OPENAI_API_KEY=""
