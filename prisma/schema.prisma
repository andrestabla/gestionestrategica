// 4Shine Empresas · Plataforma de gestión estratégica — Algoritmo T
// Motor: SQLite local vía Prisma (archivo var/4shine.db), sin servicios
// externos; el mismo esquema migra a PostgreSQL cambiando el datasource.
// El mapa (capacidades, dimensiones, prácticas, evidencias) no se persiste:
// es la definición del sistema (src/data/4shine.json). Aquí viven los datos
// de cada empresa: usuarios, mediciones, respuestas, gestión y proyectos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Identidad ───────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          String    @default("DIRECTIVO")   // ADMIN | CONSULTOR | LIDER | RESPONSABLE | DIRECTIVO
  line          Int?      // 1..4 (capacidad) si es RESPONSABLE
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  active        Boolean   @default(true)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Empresa ─────────────────────────────────────────────────────────────────

model Company {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  shortName  String
  city       String
  department String
  sector     String?
  size       String?
  logoUrl    String?
  active     Boolean @default(true)

  users         User[]
  assessments   Assessment[]
  kpis          Kpi[]
  initiatives   Initiative[]
  testResponses TestResponse[]
  teamResponses TeamResponse[]
  createdAt     DateTime @default(now())
}

// ─── Gobierno del modelo: responsables y cuadro de mando ─────────────────────

model Responsible {
  id            String @id            // R01…
  cargo         String
  dependencia   String
  rolPlataforma String               // LIDER | RESPONSABLE | APORTA | CONSULTA
}

model CmiObjective {
  id          String @id             // OE-01…
  perspective String                 // financiera | clientes | procesos | aprendizaje
  name        String
  kpis        Json                   // códigos de KPI (resultados clave)
  line        Int?                   // capacidad dominante
}

// ─── Diagnóstico 4Shine-OD: mediciones, captura y respuestas ─────────────────

model Assessment {
  id          String   @id             // A1, A2, A3…
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  label       String
  period      String                   // "2027-02"
  status      String   @default("EN_CAPTURA")   // EN_CAPTURA | PUBLICADA
  note        String?
  publishedAt DateTime?
  publishedBy String?
  scores      DimensionScore[]
  createdAt   DateTime @default(now())

  @@index([companyId, publishedAt(sort: Desc)])
}

model DimensionScore {
  id           String  @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  line         Int     // capacidad 1..4
  dimension    String  // DIR-1 … MUL-5
  value        Float   // madurez 1..5
  target       Float?  // meta a 24 meses

  @@unique([assessmentId, dimension])
}

/// Captura del corte en curso, una fila por práctica: autoevaluación del
/// responsable, marca de evidencia y nivel del advisor.
model PracticeCapture {
  id         String   @id @default(cuid())
  cut        String   @default("A3")   // corte al que pertenece
  practice   String                    // DIR-1.1 … MUL-5.4
  perception Int?                      // 1–5
  evidence   String?                   // V | P | N
  level      Int?                      // 1–5
  note       String?
  by         String
  at         DateTime @default(now())

  @@unique([cut, practice])
}

/// Estado de verificación de la evidencia de cada práctica del mapa.
model Evidence {
  id         String   @id              // EV-01…
  practice   String   @unique          // código de práctica
  status     String   @default("PENDIENTE")   // VERIFICADA | PENDIENTE
  note       String?
  fileUrl    String?
  verifiedBy String?
  verifiedAt DateTime?
}

model TestResponse {
  email     String   @id
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  role      String
  cargo     String?
  objetivo  String?
  answers   Json                      // {1..24: 1–5 | "NI", 25: A–E}
  at        DateTime @default(now())
}

/// Campos del informe de una página que completa el consultor. El participante
/// puede ser un correo de la plataforma o un participante de la demo (demo:<i>),
/// por eso no lleva relación.
model TestNote {
  participant String   @id            // email o demo:<i>
  restriccion String?
  evidencias  String?
  accion      String?
  noNecesita  String?
  by          String
  at          DateTime @default(now())
}

/// Respuesta anónima de la Fuente 2: sin usuario, sin correo, sin origen.
model TeamResponse {
  id        String   @id              // F2-0001…
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  area      String?
  answers   Json                      // F2-DIR1.a … F2-G6 → 1–5
  abierta   String?
  at        DateTime @default(now())

  @@index([companyId, at])
}

// ─── Gestor de proyectos ─────────────────────────────────────────────────────

model Person {
  id            String @id            // P01…
  name          String
  cargo         String
  dependencia   String
  email         String @unique
  responsibleId String                // enlaza con Responsible
  tasks         ProjectTask[]
}

model ProjectTask {
  id               String   @id       // T-i1-01…
  initiativeId     String?            // Initiative.id (cuid) — se resuelve en seed
  iniCode          String             // i1… (código estable del catálogo)
  title            String
  desc             String?
  assigneeId       String
  coAssigneeIds    Json?
  assignee         Person   @relation(fields: [assigneeId], references: [id])
  start            DateTime
  due              DateTime
  status           String   // POR_HACER | EN_CURSO | EN_REVISION | HECHA | BLOQUEADA
  requiresEvidence Boolean  @default(false)
  evidenceIds      Json?
  dependsOn        Json?
  note             String?

  @@index([iniCode, status])
  @@index([assigneeId, due])
}

model TaskComment {
  id       Int      @id @default(autoincrement())
  taskId   String
  author   String
  role     String
  text     String
  at       DateTime @default(now())

  @@index([taskId, at])
}

model FileAsset {
  id         String   @id            // EV-U01…
  taskId     String
  title      String
  kind       String
  fileName   String
  filePath   String
  size       Int
  mime       String
  uploadedBy String
  status     String   @default("PENDIENTE")
  at         DateTime @default(now())

  @@index([taskId])
}

// ─── Indicadores ─────────────────────────────────────────────────────────────

model Kpi {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])
  line          Int
  code          String
  name          String
  definition    String?
  formula       String?
  cmiObjective  String?
  unit          String
  source        String?
  ownerRole     String?
  frequency     String   @default("TRIMESTRAL")
  baseline      Float?
  target        Float?
  goodDirection String  @default("up")
  values        KpiValue[]
  initiatives   Initiative[]

  @@unique([companyId, code])
  @@index([companyId, line])
}

model KpiValue {
  id        String   @id @default(cuid())
  kpiId     String
  kpi       Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  period    String   // "2026-T1"
  value     Float
  note      String?
  createdAt DateTime @default(now())

  @@unique([kpiId, period])
}

// ─── Ruta e iniciativas ──────────────────────────────────────────────────────

model Initiative {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  code           String                            // i1…
  line           Int
  name           String
  description    String?
  subsistema     String?
  cmiObjective   String?
  dimension      String?                           // dimensión que instala (DIR-4…)
  framework      String?                           // framework que trabaja (F04…)
  metaResultado  String?
  actions        Json?
  log            Json?
  nextMilestone  Json?
  horizon        String                            // CORTO | MEDIANO
  impact         Int
  feasibility    Int
  urgency        Int      @default(3)
  dependency     Int      @default(3)
  status         String   @default("PLANEADA")
  ownerRole      String?
  startQuarter   String?
  endQuarter     String?
  budgetPlanned   Float   @default(0)
  budgetCommitted Float   @default(0)
  budgetExecuted  Float   @default(0)
  progress       Int      @default(0)
  kpiId          String?
  kpi            Kpi?     @relation(fields: [kpiId], references: [id])
  successFactors SuccessFactor[]

  @@unique([companyId, code])
  @@index([companyId, horizon])
}

model SuccessFactor {
  id           String   @id @default(cuid())
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name         String
  state        String   @default("VERDE")
  history      Json?
  note         String?
  reviewedAt   DateTime @default(now())
}
